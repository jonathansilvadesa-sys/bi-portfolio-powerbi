// ============================================================
// PROJETO 03 — E-COMMERCE (Dataset Olist)
// Segmentação RFM como TABELA CALCULADA
// Autor: Jonathan Silva de Sá
//
// Por que tabela calculada e não medida: o RFM de cada cliente não muda
// com os filtros do relatório. Como medida, os percentis seriam
// recalculados sobre ~95 mil clientes a cada célula de cada visual.
// Como tabela, o cálculo roda uma vez, no refresh, e os limites dos
// quintis são calculados uma única vez (variáveis), não por linha.
//
// Por que frequência em faixas fixas e não em quintis: 97% dos clientes
// compraram uma única vez. Quintil de uma coluna em que quase tudo é 1
// joga todo mundo no mesmo grupo.
//
// Relacionamento: dRFM[id_cliente_unico] 1:1 dClientes[id_cliente_unico],
// filtro cruzado nos dois sentidos (o Power BI sugere isso em 1:1).
// Classifique dRFM[Segmento] pela coluna dRFM[OrdemSegmento].
// ============================================================

dRFM =
VAR DataReferencia =
    CALCULATE ( MAX ( dCalendario[Data] ), ALL ( dCalendario ) ) + 1     // 01/09/2018
VAR Base =
    CALCULATETABLE (
        ADDCOLUMNS (
            SUMMARIZE ( fItens, fItens[id_cliente_unico] ),
            "Recencia", INT ( DataReferencia - CALCULATE ( MAX ( fItens[data_pedido] ) ) ),
            "Frequencia", CALCULATE ( DISTINCTCOUNT ( fItens[id_pedido] ) ),
            "Valor", CALCULATE ( SUM ( fItens[receita] ) )
        ),
        fItens[pedido_valido] = TRUE ()
    )
// limites dos quintis, calculados uma vez
VAR R20 = PERCENTILEX.INC ( Base, [Recencia], 0.2 )
VAR R40 = PERCENTILEX.INC ( Base, [Recencia], 0.4 )
VAR R60 = PERCENTILEX.INC ( Base, [Recencia], 0.6 )
VAR R80 = PERCENTILEX.INC ( Base, [Recencia], 0.8 )
VAR M20 = PERCENTILEX.INC ( Base, [Valor], 0.2 )
VAR M40 = PERCENTILEX.INC ( Base, [Valor], 0.4 )
VAR M60 = PERCENTILEX.INC ( Base, [Valor], 0.6 )
VAR M80 = PERCENTILEX.INC ( Base, [Valor], 0.8 )
VAR ComNotas =
    ADDCOLUMNS (
        Base,
        // recência: quanto mais recente, maior a nota
        "R", SWITCH ( TRUE (), [Recencia] <= R20, 5, [Recencia] <= R40, 4, [Recencia] <= R60, 3, [Recencia] <= R80, 2, 1 ),
        // frequência: faixas fixas (1, 2, 3 ou mais pedidos)
        "F", SWITCH ( TRUE (), [Frequencia] >= 3, 3, [Frequencia] = 2, 2, 1 ),
        "M", SWITCH ( TRUE (), [Valor] <= M20, 1, [Valor] <= M40, 2, [Valor] <= M60, 3, [Valor] <= M80, 4, 5 )
    )
RETURN
    ADDCOLUMNS (
        ComNotas,
        // As regras não se sobrepõem: a ordem do SWITCH não esconde nenhum segmento.
        "Segmento",
            SWITCH (
                TRUE (),
                [F] >= 2 && [R] >= 4, "Campeões",
                [F] >= 2 && [R] <= 2, "Recorrentes em risco",
                [F] >= 2, "Recorrentes",
                [R] = 5, "Novos",
                [R] >= 3, "Compradores ocasionais",
                "Inativos"
            ),
        "OrdemSegmento",
            SWITCH (
                TRUE (),
                [F] >= 2 && [R] >= 4, 1,
                [F] >= 2 && [R] <= 2, 3,
                [F] >= 2, 2,
                [R] = 5, 4,
                [R] >= 3, 5,
                6
            )
    )


// ────────────────────────────────────────────────────────────
// MEDIDAS DE APOIO
// ────────────────────────────────────────────────────────────

Clientes RFM =
COUNTROWS ( dRFM )

% Clientes no Segmento =
DIVIDE ( [Clientes RFM], CALCULATE ( [Clientes RFM], ALL ( dRFM[Segmento], dRFM[OrdemSegmento] ) ) )

Valor Medio por Cliente =
AVERAGE ( dRFM[Valor] )

Recencia Media (dias) =
AVERAGE ( dRFM[Recencia] )
