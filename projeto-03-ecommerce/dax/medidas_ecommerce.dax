// ============================================================
// PROJETO 03 — E-COMMERCE (Dataset Olist)
// Calendário e medidas. Valores de conferência em docs/numeros_de_conferencia.md
// Autor: Jonathan Silva de Sá
// ============================================================


// ────────────────────────────────────────────────────────────
// TABELA CALCULADA: dCalendario
// Modelagem > Nova tabela. Depois: Marcar como tabela de datas (coluna Data)
// e classificar MesAno pela coluna AnoMesNum.
// ────────────────────────────────────────────────────────────
dCalendario =
ADDCOLUMNS (
    SELECTCOLUMNS ( CALENDAR ( DATE ( 2017, 1, 1 ), DATE ( 2018, 8, 31 ) ), "Data", [Date] ),
    "Ano", YEAR ( [Data] ),
    "Trimestre", "T" & QUARTER ( [Data] ),
    "MesNum", MONTH ( [Data] ),
    "Mes", FORMAT ( [Data], "mmm", "pt-BR" ),
    "MesAno", FORMAT ( [Data], "mmm/yy", "pt-BR" ),
    "AnoMesNum", YEAR ( [Data] ) * 100 + MONTH ( [Data] ),
    "DiaSemana", FORMAT ( [Data], "ddd", "pt-BR" ),
    "DiaSemanaNum", WEEKDAY ( [Data], 2 )
)


// ────────────────────────────────────────────────────────────
// RECEITA E VOLUME
// Receita = preço + frete dos itens de pedidos válidos
// (sem cancelados e indisponíveis). Uma única definição para o modelo todo.
// ────────────────────────────────────────────────────────────

Receita =
CALCULATE ( SUM ( fItens[receita] ), fItens[pedido_valido] = TRUE () )

Receita Produtos =
CALCULATE ( SUM ( fItens[valor_produto] ), fItens[pedido_valido] = TRUE () )

Receita Frete =
CALCULATE ( SUM ( fItens[valor_frete] ), fItens[pedido_valido] = TRUE () )

% Frete na Receita =
DIVIDE ( [Receita Frete], [Receita] )

Pedidos =
CALCULATE ( DISTINCTCOUNT ( fPedidos[id_pedido] ), fPedidos[pedido_valido] = TRUE () )

// Ticket médio divide pelos pedidos que têm itens (5 pedidos válidos não têm)
Pedidos com Itens =
CALCULATE ( DISTINCTCOUNT ( fItens[id_pedido] ), fItens[pedido_valido] = TRUE () )

Ticket Medio =
DIVIDE ( [Receita], [Pedidos com Itens] )

Pedidos Cancelados =
CALCULATE ( COUNTROWS ( fPedidos ), fPedidos[pedido_valido] = FALSE () )

% Cancelamento =
DIVIDE ( [Pedidos Cancelados], COUNTROWS ( fPedidos ) )


// ────────────────────────────────────────────────────────────
// CLIENTES E RECOMPRA
// Cliente = id_cliente_unico (customer_unique_id). O customer_id do
// dataset muda a cada pedido e faria todo cliente parecer novo.
// ────────────────────────────────────────────────────────────

Clientes =
CALCULATE ( DISTINCTCOUNT ( fPedidos[id_cliente_unico] ), fPedidos[pedido_valido] = TRUE () )

Clientes Recorrentes =
COUNTROWS (
    FILTER (
        VALUES ( fPedidos[id_cliente_unico] ),
        CALCULATE ( DISTINCTCOUNT ( fPedidos[id_pedido] ), fPedidos[pedido_valido] = TRUE () ) >= 2
    )
)

Taxa de Recompra =
DIVIDE ( [Clientes Recorrentes], [Clientes] )

Pedidos por Cliente =
DIVIDE ( [Pedidos], [Clientes] )


// ────────────────────────────────────────────────────────────
// TEMPO
// ────────────────────────────────────────────────────────────

Receita Ano Anterior =
CALCULATE ( [Receita], SAMEPERIODLASTYEAR ( dCalendario[Data] ) )

// Só calcula quando o período inteiro do ano anterior está na janela
Crescimento vs Ano Anterior =
VAR Atual = [Receita]
VAR Anterior = [Receita Ano Anterior]
RETURN
    IF ( NOT ISBLANK ( Anterior ), DIVIDE ( Atual - Anterior, Anterior ) )

Receita Acumulada no Ano =
TOTALYTD ( [Receita], dCalendario[Data] )

// Média móvel de 3 MESES: itera os meses, não os dias.
// AVERAGEX sobre DATESINPERIOD faria a média de ~90 dias.
Receita Media Movel 3M =
VAR Janela =
    DATESINPERIOD ( dCalendario[Data], MAX ( dCalendario[Data] ), -3, MONTH )
VAR MesesNaJanela =
    CALCULATE ( DISTINCTCOUNT ( dCalendario[AnoMesNum] ), Janela )
RETURN
    IF (
        MesesNaJanela = 3,     // nos 2 primeiros meses da janela não há 3 meses para a média
        CALCULATE ( AVERAGEX ( VALUES ( dCalendario[AnoMesNum] ), [Receita] ), Janela )
    )


// ────────────────────────────────────────────────────────────
// CATEGORIAS E ESTADOS
// ────────────────────────────────────────────────────────────

% Receita no Total Selecionado =
DIVIDE ( [Receita], CALCULATE ( [Receita], ALLSELECTED ( dProdutos[categoria] ) ) )

Ranking Categoria =
IF (
    HASONEVALUE ( dProdutos[categoria] ),
    RANKX ( ALLSELECTED ( dProdutos[categoria] ), [Receita], , DESC, DENSE )
)


// ────────────────────────────────────────────────────────────
// LOGÍSTICA
// Entregas = pedidos com status "delivered" e data de entrega preenchida.
// ────────────────────────────────────────────────────────────

Entregas =
CALCULATE (
    COUNTROWS ( fPedidos ),
    fPedidos[status_pedido] = "delivered",
    NOT ISBLANK ( fPedidos[data_entrega] )
)

Prazo Medio de Entrega (dias) =
CALCULATE (
    AVERAGE ( fPedidos[dias_ate_entrega] ),
    fPedidos[status_pedido] = "delivered",
    NOT ISBLANK ( fPedidos[data_entrega] )
)

% Entregue no Prazo =
DIVIDE (
    CALCULATE ( [Entregas], fPedidos[entregue_no_prazo] = TRUE () ),
    [Entregas]
)


// ────────────────────────────────────────────────────────────
// SATISFAÇÃO
// A nota do Olist vai de 1 a 5, então não é NPS (que usa 0 a 10).
// ────────────────────────────────────────────────────────────

Nota Media =
CALCULATE ( AVERAGE ( fPedidos[nota_avaliacao] ), fPedidos[pedido_valido] = TRUE () )

Pedidos Avaliados =
CALCULATE (
    COUNTROWS ( fPedidos ),
    fPedidos[pedido_valido] = TRUE (),
    NOT ISBLANK ( fPedidos[nota_avaliacao] )
)

% Nota 5 =
DIVIDE ( CALCULATE ( [Pedidos Avaliados], fPedidos[nota_avaliacao] = 5 ), [Pedidos Avaliados] )

% Notas 1 e 2 =
DIVIDE ( CALCULATE ( [Pedidos Avaliados], fPedidos[nota_avaliacao] <= 2 ), [Pedidos Avaliados] )

Nota Media no Prazo =
CALCULATE (
    AVERAGE ( fPedidos[nota_avaliacao] ),
    fPedidos[status_pedido] = "delivered",
    fPedidos[entregue_no_prazo] = TRUE ()
)

Nota Media com Atraso =
CALCULATE (
    AVERAGE ( fPedidos[nota_avaliacao] ),
    fPedidos[status_pedido] = "delivered",
    fPedidos[entregue_no_prazo] = FALSE ()
)


// ────────────────────────────────────────────────────────────
// TEXTOS PARA CARTÕES E TÍTULOS
// ────────────────────────────────────────────────────────────

Titulo Atraso =
"Atraso derruba a nota de " & FORMAT ( [Nota Media no Prazo], "0.0" ) & " para "
    & FORMAT ( [Nota Media com Atraso], "0.0" )

Titulo Recompra =
FORMAT ( 1 - [Taxa de Recompra], "0%" ) & " dos clientes compraram uma única vez"
